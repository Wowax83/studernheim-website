# ===== Studernheim Website =====
# Kopiere diese Datei nach .env (NICHT in Git committen) und fuelle die Werte.
# Echte Tokens liegen in /store/KI/KI Projekt/new.txt -- nicht duplizieren,
# sondern referenzieren oder per `cp` uebernehmen.
#
# Beispiel:
#   cp .env.example .env
#   grep -E "DATABASE_URL|SANITY_PROJECT_ID|RESEND_API_KEY" /store/KI/KI\ Projekt/new.txt | sed 's/^/export /' >> .env

# --- Sanity CMS ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# SANITY_API_READ_TOKEN=
# SANITY_API_WRITE_TOKEN=

# --- Datenbank (Prisma) ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/studernheim
# DIRECT_URL=

# --- Mailversand (Resend) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Oeffentliche URLs ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
